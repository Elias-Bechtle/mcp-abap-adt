{
  "name": "@janfrl/mcp-abap-adt",
  "version": "2.0.0",
  "mcpName": "io.github.janfrl/mcp-abap-adt",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "mcp-abap-adt": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --dir tests/integration",
    "start": "node ./dist/index.js",
    "dev": "npx @modelcontextprotocol/inspector node ./dist/index.js",
    "prepublishOnly": "npm run build",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "keywords": [
    "abap",
    "sap",
    "adt",
    "mcp",
    "model-context-protocol"
  ],
  "author": "janfrl",
  "contributors": [
    "mario-andreschak (original author of mcp-abap-adt)"
  ],
  "description": "ABAP ADT (ABAP Development Tools) MCP Server for interacting with SAP systems",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janfrl/mcp-abap-adt.git"
  },
  "homepage": "https://github.com/janfrl/mcp-abap-adt#readme",
  "bugs": {
    "url": "https://github.com/janfrl/mcp-abap-adt/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@zowe/secrets-for-zowe-sdk": "^8.33.4",
    "c12": "^3.3.4",
    "ofetch": "^1.5.1",
    "undici": "^8.10.0",
    "xml-js": "^1.6.11",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
