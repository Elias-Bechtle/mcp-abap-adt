# Single-system setup. Setting all four SAP_* variables below creates one
# system named "default", which is used when a tool call omits "system".
#
# For several systems, use mcp-abap-adt.config.jsonc instead
# (see mcp-abap-adt.config.example.jsonc) — that also lets you keep passwords
# out of files entirely via the OS keychain.
#
# Never commit a filled-in .env file.

# Base URL of the SAP system. If your password contains "#", quote the value.
SAP_URL=https://your-sap-system.com:44300
SAP_USERNAME=your_username
SAP_PASSWORD=your_password
SAP_CLIENT=100

# Optional: logon language, e.g. EN or DE.
# Note: this is actually applied since 2.0; 1.x ignored it.
SAP_LANGUAGE=

# Optional: set to 0 to accept self-signed or internally issued certificates.
# Certificates are verified by default since 2.0; 1.x never verified them.
TLS_REJECT_UNAUTHORIZED=

# Optional: path to a multi-system configuration file.
MCP_ABAP_ADT_CONFIG=

# Optional: set to 1 for extra diagnostics on stderr.
MCP_ABAP_ADT_DEBUG=